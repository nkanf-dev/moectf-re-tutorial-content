{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moectf.local/schemas/course.schema.json",
  "title": "MoeCTF RE Tutorial Course Manifest",
  "description": "Runtime course manifest. It declares course metadata, changelog, requirements, and stage flow. Per-step external-window locators, triggers, and deviations stay in guide-stage.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "metadata", "requirements", "flow"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "id": { "$ref": "#/$defs/id" },
    "version": {
      "type": "string",
      "description": "Semantic version for this course only. It is independent from the catalog and other courses.",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "status": { "enum": ["draft", "preview", "published", "archived"], "default": "draft" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "changelog": {
      "type": "array",
      "items": { "$ref": "#/$defs/changelogEntry" },
      "default": []
    },
    "content": { "$ref": "#/$defs/contentPaths" },
    "requirements": { "$ref": "#/$defs/requirementGroup" },
    "flow": { "$ref": "#/$defs/courseFlow" },
    "updateManifestUrl": { "type": ["string", "null"], "format": "uri" },
    "appUpdateManifestUrl": { "type": ["string", "null"], "format": "uri" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "i18nKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "summary"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "titleKey": { "$ref": "#/$defs/i18nKey" },
        "subtitle": { "type": "string" },
        "subtitleKey": { "$ref": "#/$defs/i18nKey" },
        "summary": { "type": "string", "minLength": 1 },
        "summaryKey": { "$ref": "#/$defs/i18nKey" },
        "track": { "type": "string", "default": "Reverse" },
        "difficulty": { "type": "string", "default": "Beginner" },
        "estimatedMinutes": { "type": "integer", "minimum": 0 },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "default": []
        },
        "authors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        },
        "icon": { "$ref": "#/$defs/contentPath" },
        "homepageUrl": { "type": ["string", "null"], "format": "uri" }
      }
    },
    "changelogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "date", "text"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "format": "date" },
        "text": { "type": "string", "minLength": 1 },
        "items": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        }
      }
    },
    "contentPaths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stagesDir": { "$ref": "#/$defs/relativeDir", "default": "stages" },
        "i18nDir": { "$ref": "#/$defs/relativeDir", "default": "assets/i18n" },
        "assetsDir": { "$ref": "#/$defs/relativeDir", "default": "assets" },
        "stageIndex": { "$ref": "#/$defs/contentPath", "default": "stages/index.json" }
      }
    },
    "requirementExpr": {
      "oneOf": [
        { "$ref": "#/$defs/requirementGroup" },
        { "$ref": "#/$defs/requirementLeaf" }
      ]
    },
    "requirementGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string" },
        "titleKey": { "$ref": "#/$defs/i18nKey" },
        "description": { "type": "string" },
        "descriptionKey": { "$ref": "#/$defs/i18nKey" },
        "allOf": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/requirementExpr" }
        },
        "anyOf": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/requirementExpr" }
        }
      },
      "oneOf": [
        { "required": ["allOf"] },
        { "required": ["anyOf"] }
      ]
    },
    "requirementLeaf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "match"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["tool", "target"] },
        "label": { "type": "string", "minLength": 1 },
        "labelKey": { "$ref": "#/$defs/i18nKey" },
        "description": { "type": "string" },
        "descriptionKey": { "$ref": "#/$defs/i18nKey" },
        "toolId": { "$ref": "#/$defs/id" },
        "targetId": { "$ref": "#/$defs/id" },
        "match": { "$ref": "#/$defs/requirementMatch" },
        "asset": { "$ref": "#/$defs/targetAsset" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "tool" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["toolId"],
            "not": {
              "anyOf": [
                { "required": ["targetId"] },
                { "required": ["asset"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "target" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["targetId", "asset"],
            "not": { "required": ["toolId"] }
          }
        }
      ]
    },
    "requirementMatch": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        { "required": ["fileNames"] },
        { "required": ["pathContains"] },
        { "required": ["sha256"] },
        { "required": ["size"] }
      ],
      "properties": {
        "fileNames": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "default": []
        },
        "pathContains": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "default": []
        },
        "sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "size": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "recursive": { "type": "boolean", "default": true }
      }
    },
    "targetAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "allOf": [
            { "$ref": "#/$defs/contentPath" },
            { "pattern": "^courses/[^/]+/assets/targets/[^/]+$" }
          ]
        },
        "copyMode": { "const": "copy" },
        "companions": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "#/$defs/contentPath" },
              { "pattern": "^courses/[^/]+/assets/targets/[^/]+$" }
            ]
          },
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "courseFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "stages"],
      "properties": {
        "entry": { "$ref": "#/$defs/id" },
        "stages": {
          "type": "array",
          "items": { "$ref": "#/$defs/stageRef" },
          "default": []
        }
      }
    },
    "stageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "$ref": "#/$defs/contentPath" },
        "titleKey": { "$ref": "#/$defs/i18nKey" },
        "requires": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true,
          "default": []
        },
        "when": { "$ref": "#/$defs/flowCondition" },
        "next": {
          "type": "array",
          "items": { "$ref": "#/$defs/stageTransition" },
          "default": []
        }
      }
    },
    "stageTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["to"],
      "properties": {
        "to": { "$ref": "#/$defs/id" },
        "when": { "$ref": "#/$defs/flowCondition" }
      }
    },
    "flowCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["always", "all", "any", "requirement_choice", "requirement_satisfied"]
        },
        "not": { "type": "boolean", "default": false },
        "groupId": { "$ref": "#/$defs/id" },
        "requirementId": { "$ref": "#/$defs/id" },
        "all": {
          "type": "array",
          "items": { "$ref": "#/$defs/flowCondition" },
          "default": []
        },
        "any": {
          "type": "array",
          "items": { "$ref": "#/$defs/flowCondition" },
          "default": []
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "requirement_choice" } },
            "required": ["kind"]
          },
          "then": { "required": ["groupId", "requirementId"] }
        },
        {
          "if": {
            "properties": { "kind": { "const": "requirement_satisfied" } },
            "required": ["kind"]
          },
          "then": { "required": ["requirementId"] }
        },
        {
          "if": {
            "properties": { "kind": { "const": "all" } },
            "required": ["kind"]
          },
          "then": { "required": ["all"] }
        },
        {
          "if": {
            "properties": { "kind": { "const": "any" } },
            "required": ["kind"]
          },
          "then": { "required": ["any"] }
        }
      ]
    },
    "relativeDir": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^[A-Za-z]:" },
          { "pattern": "^/" },
          { "pattern": "\\\\" },
          { "pattern": "(^|/)\\.\\.(/|$)" }
        ]
      }
    },
    "contentPath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^[A-Za-z]:" },
          { "pattern": "^/" },
          { "pattern": "\\\\" },
          { "pattern": "(^|/)\\.\\.(/|$)" },
          { "pattern": "\\.(pdb|id0|id1|id2|nam|til|idb|i64)$" }
        ]
      }
    }
  }
}
