{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moectf.local/schemas/guide-stage.schema.json",
  "title": "MoeCTF RE Tutorial Stage",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "order", "titleKey", "goalKey", "answerKey", "targets", "tools", "guideMode", "steps"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "order": { "type": "integer", "minimum": 0 },
    "titleKey": { "type": "string" },
    "goalKey": { "type": "string" },
    "answerKey": { "type": "string" },
    "fakeAnswerKeys": { "type": "array", "items": { "type": "string" } },
    "targets": { "type": "array", "items": { "type": "string" } },
    "tools": {
      "type": "array",
      "items": { "enum": ["die", "ida", "ghidra", "dnspy", "x64dbg"] }
    },
    "guideMode": { "enum": ["forced", "on_fake_or_next", "none"] },
    "freeExploreTextKey": { "type": ["string", "null"] },
    "deviations": {
      "type": "array",
      "items": { "$ref": "#/$defs/deviation" }
    },
    "steps": {
      "type": "array",
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "textKey", "action", "guide"],
      "properties": {
        "id": { "type": "string" },
        "textKey": { "type": "string" },
        "bodyKey": { "type": ["string", "null"] },
        "image": { "$ref": "#/$defs/optionalMediaPath" },
        "action": { "const": "none" },
        "tool": { "type": ["string", "null"] },
        "file": { "type": ["string", "null"] },
        "guide": { "$ref": "#/$defs/guide" },
        "trigger": { "$ref": "#/$defs/condition" },
        "branches": {
          "type": "array",
          "items": { "$ref": "#/$defs/branch" }
        }
      }
    },
    "deviation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "textKey", "when"],
      "properties": {
        "id": { "type": "string" },
        "textKey": { "type": "string" },
        "priority": { "type": "integer", "default": 0 },
        "when": { "$ref": "#/$defs/condition" },
        "guide": { "$ref": "#/$defs/guide" }
      }
    },
    "guide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "locators"],
      "properties": {
        "target": { "$ref": "#/$defs/target" },
        "locators": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/locator" }
        },
        "overlay": { "$ref": "#/$defs/overlay" },
        "fallback": { "$ref": "#/$defs/target" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": { "$ref": "#/$defs/scope" },
        "key": { "type": "string" },
        "process": { "type": "string" },
        "adapter": { "$ref": "#/$defs/adapter" },
        "titleContains": { "$ref": "#/$defs/stringList" },
        "processNameContains": { "$ref": "#/$defs/stringList" },
        "exeNameContains": { "$ref": "#/$defs/stringList" },
        "exePathContains": { "$ref": "#/$defs/stringList" },
        "windowClassNameContains": { "$ref": "#/$defs/stringList" },
        "titlePidFromProcess": { "type": "string" }
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": { "enum": ["auto", "host", "uia", "win32", "window", "process_window", "rect", "none"] },
        "scope": { "$ref": "#/$defs/scope" },
        "key": { "type": "string" },
        "process": { "type": "string" },
        "adapter": { "$ref": "#/$defs/adapter" },
        "state": { "type": "string" },
        "role": { "type": "string" },
        "nameEquals": { "type": "string" },
        "nameContains": { "$ref": "#/$defs/stringList" },
        "contentContains": { "$ref": "#/$defs/stringList" },
        "contentMode": { "enum": ["evidence", "target"] },
        "rejectTitleContains": { "$ref": "#/$defs/stringList" },
        "rejectContentContains": { "$ref": "#/$defs/stringList" },
        "requireAllNameContains": { "type": "boolean" },
        "automationId": { "type": "string" },
        "className": { "type": "string" },
        "controlType": { "type": "string" },
        "titleContains": { "$ref": "#/$defs/stringList" },
        "processNameContains": { "$ref": "#/$defs/stringList" },
        "exeNameContains": { "$ref": "#/$defs/stringList" },
        "exePathContains": { "$ref": "#/$defs/stringList" },
        "windowClassNameContains": { "$ref": "#/$defs/stringList" },
        "titlePidFromProcess": { "type": "string" },
        "rect": { "$ref": "#/$defs/rect" },
        "adjust": { "$ref": "#/$defs/adjust" },
        "fallbackToWindow": { "type": "boolean" },
        "maxNodes": { "type": "integer", "minimum": 50, "maximum": 10000 },
        "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 10000 }
      }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "space": { "enum": ["screen", "window", "target", "host", "control", "anchor"] }
      }
    },
    "adjust": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "offsetX": { "type": "number" },
        "offsetY": { "type": "number" },
        "inflate": { "type": "number" },
        "width": { "type": ["number", "null"] },
        "height": { "type": ["number", "null"] }
      }
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "placement": { "enum": ["auto", "top", "bottom", "left", "right", "inside"] },
        "alignment": { "enum": ["start", "center", "end"] },
        "padding": { "type": "number", "minimum": 0 },
        "gap": { "type": "number", "minimum": 0 },
        "offsetX": { "type": "number" },
        "offsetY": { "type": "number" },
        "maxWidth": { "type": ["number", "null"] }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "when"],
      "properties": {
        "trigger": { "type": "string" },
        "when": { "$ref": "#/$defs/condition" },
        "next": { "type": ["string", "null"] }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["always", "all", "any", "process_running", "window_visible", "locator_found", "host_visible", "value_equals", "value_contains"]
        },
        "not": { "type": "boolean" },
        "process": { "type": "string" },
        "key": { "type": "string" },
        "value": { "type": "string" },
        "valueKey": { "type": "string" },
        "locator": { "$ref": "#/$defs/locator" },
        "all": { "type": "array", "items": { "$ref": "#/$defs/condition" } },
        "any": { "type": "array", "items": { "$ref": "#/$defs/condition" } }
      }
    },
    "scope": { "enum": ["host", "process", "screen", "none"] },
    "adapter": { "enum": ["die", "ida", "ghidra", "dnspy", "x64dbg", "win32"] },
    "optionalMediaPath": {
      "type": ["string", "null"],
      "pattern": "^(assets/media/)?[^\\\\:*?\"<>|]+\\.(png|jpg|jpeg|webp)$"
    },
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
