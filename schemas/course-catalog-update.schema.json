{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moectf.local/schemas/course-catalog-update.schema.json",
  "title": "MoeCTF RE Tutorial Published Course Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogVersion", "courses"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "catalogVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "publishedAt": { "type": ["string", "null"], "format": "date-time" },
    "catalogUpdateManifestUrl": { "type": ["string", "null"], "format": "uri" },
    "appUpdateManifestUrl": { "type": ["string", "null"], "format": "uri" },
    "courses": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "compatibility", "manifest", "updateManifestUrl"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
          },
          "compatibility": { "$ref": "#/$defs/hostCompatibility" },
          "manifest": { "type": "string", "pattern": "^courses/[^/]+/course\\.json$" },
          "updateManifestUrl": { "type": "string", "minLength": 1 },
          "appUpdateManifestUrl": { "type": ["string", "null"], "format": "uri" }
        }
      }
    }
  },
  "$defs": {
    "hostVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "hostCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minHostVersion", "maxHostVersionExclusive"],
      "properties": {
        "minHostVersion": { "$ref": "#/$defs/hostVersion" },
        "maxHostVersionExclusive": { "$ref": "#/$defs/hostVersion" }
      }
    }
  }
}
